{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "source": "$HOME/.config/fastfetch/logo.png",
    "height": 30,
    "width": 30,
    "padding": {
      "right": 2
    }
  },
  "display": {
    "separator": " ",
    "size": {
      "binaryPrefix": "iec"
    },
    "color": {
      "output": "223"
    }
  },
  "modules": [
    {
      "type": "title",
      "key": "╭─",
      "keyColor": "214"
    },
    {
      "type": "separator",
      "string": "─"
    },
    {
      "type": "os",
      "key": "├ OS",
      "keyColor": "208",
      "format": "\u001b[38;5;65m{2} {12}\u001b[0m"
    },
    {
      "type": "kernel",
      "key": "├ Kernel",
      "keyColor": "214",
      "format": "\u001b[38;5;109m{1} {2}\u001b[0m"
    },
    {
      "type": "uptime",
      "key": "├ Uptime",
      "keyColor": "142"
    },
    {
      "type": "shell",
      "key": "├ Shell",
      "keyColor": "175",
      "format": "\u001b[38;5;109m{1} {2}\u001b[0m"
    },
    {
      "type": "display",
      "key": "├ Display",
      "keyColor": "208",
      "format": "\u001b[38;5;65m{1}×{2}\u001b[0m @ \u001b[38;5;214m{5} Hz\u001b[0m"
    },
    {
      "type": "wm",
      "key": "├ WM",
      "keyColor": "109",
      "format": "\u001b[38;5;214m{1}\u001b[0m \u001b[38;5;109m({3})\u001b[0m"
    },
    {
      "type": "packages",
      "key": "├ Packages",
      "keyColor": "109",
      "format": "\u001b[38;5;214m{1}\u001b[0m \u001b[38;5;142m({2})\u001b[0m"
    },
    {
      "type": "separator",
      "string": "─"
    },
    {
      "type": "memory",
      "key": "├ Memory",
      "keyColor": "208",
      "format": "\u001b[38;5;196m{1}\u001b[0m / \u001b[38;5;65m{2}\u001b[0m \u001b[38;5;214m({3})\u001b[0m"
    },
    {
      "type": "battery",
      "key": "├ Battery",
      "keyColor": "214",
      "format": "\u001b[38;5;65m{4}\u001b[0m \u001b[38;5;175m[{5}]\u001b[0m"
    },
    {
      "type": "poweradapter",
      "key": "├ Power",
      "keyColor": "167",
      "format": "\u001b[38;5;214m{1}\u001b[0m"
    },
    {
      "type": "locale",
      "key": "├ Locale",
      "keyColor": "142",
      "format": "\u001b[38;5;175m{1}\u001b[0m"
    },
    {
      "type": "separator",
      "string": "─"
    },
    {
      "type": "colors",
      "key": "╰─ Colors",
      "keyColor": "214",
      "symbol": "circle"
    }
  ]
}
